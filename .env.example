PROMPT_VAULT_APP_NAME="Prompt Vault"
PROMPT_VAULT_DEFAULT_PAGE_SIZE=20
PROMPT_VAULT_DATABASE_URL="sqlite:///./data/prompts.db"
# Uncomment to enable Redis caching and rate limiting:
# PROMPT_VAULT_REDIS_URL="redis://localhost:6379/0"
# PROMPT_VAULT_RATE_LIMIT_PER_MINUTE=60

# Analyzer microservice — set to use real Claude, omit for mock mode
# ANTHROPIC_API_KEY="sk-ant-..."
# PROMPT_VAULT_ANALYZER_URL="http://localhost:8001"

# JWT auth — rotate JWT_SECRET before any shared deployment
# Generate a new secret: python -c "import secrets; print(secrets.token_hex(32))"
# PROMPT_VAULT_JWT_SECRET="change-me-before-production-32ch"
# PROMPT_VAULT_JWT_ISSUER="prompt-vault"
# PROMPT_VAULT_JWT_AUDIENCE="prompt-vault-clients"
# PROMPT_VAULT_JWT_EXPIRY_MINUTES=30
